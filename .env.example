# ─── IBM watsonx Orchestrate (primary) ───────────────────────────────────────
# Get these from: IBM Cloud → watsonx Orchestrate → your instance → Deployment

NEXT_PUBLIC_WXO_HOST_URL=https://eu-gb.watson-orchestrate.cloud.ibm.com
NEXT_PUBLIC_WXO_ORCHESTRATION_ID=your_orchestration_id
NEXT_PUBLIC_WXO_CRN=crn:v1:bluemix:public:watsonx-orchestrate:eu-gb:a/...
NEXT_PUBLIC_WXO_AGENT_ID=your_agent_id
NEXT_PUBLIC_WXO_AGENT_ENVIRONMENT_ID=your_agent_environment_id
NEXT_PUBLIC_WXO_DEPLOYMENT_PLATFORM=ibmcloud

# ─── Watson Assistant Web Chat (optional fallback) ────────────────────────────
# Only needed if NOT using WXO above
# NEXT_PUBLIC_WATSON_INTEGRATION_ID=your_integration_id
# NEXT_PUBLIC_WATSON_REGION=eu-gb
# NEXT_PUBLIC_WATSON_SERVICE_INSTANCE_ID=your_instance_id

# ─── Optional overrides ───────────────────────────────────────────────────────
# NEXT_PUBLIC_WATSON_LOCALE=en
# NEXT_PUBLIC_WATSON_DEBUG=false
